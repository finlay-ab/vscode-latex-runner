{
  "name": "vscode-latex-runner",
  "displayName": "LaTeX Instant Runner",
  "description": "Instantly compile LaTeX to PDF with zero configuration using Tectonic.",
  "version": "0.1.0",
  "publisher": "finlay-ab",
  "icon": "icon.png",
  "keywords": [
    "latex",
    "tex",
    "pdf",
    "compiler",
    "runner"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/finlay-ab/vscode-latex-runner.git"
  },
  "bugs": {
    "url": "https://github.com/finlay-ab/vscode-latex-runner/issues"
  },
  "homepage": "https://github.com/finlay-ab/vscode-latex-runner#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onDebugResolve:latex-build"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-latex-runner.runBuild",
        "title": "Build LaTeX PDF",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == latex || resourceLangId == tex",
          "command": "vscode-latex-runner.runBuild",
          "group": "navigation"
        }
      ]
    },
    "debuggers": [
      {
        "type": "latex-build",
        "label": "LaTeX Instant Runner",
        "languages": [
          "latex",
          "tex"
        ],
        "configurationSnippets": [
          {
            "label": "LaTeX: Build Current File",
            "description": "Compiles the active LaTeX file using Tectonic",
            "body": {
              "type": "latex-build",
              "request": "launch",
              "name": "Build LaTeX"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  }
}
